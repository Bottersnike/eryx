suite:test("float constructors cloning parsing and module helpers cover core cases", function()
	local originalPrecision = float.defaultPrecision()
	local value = f("1.25", 80)
	local clone = float.new(value, 40)
	local samePrecisionClone = float.new(value)

	test.expect(tostring(float.new())):toBe("0")
	test.expect(tostring(value)):toBe("1.25")
	test.expect(tostring(clone)):toBe("1.25")
	test.expect(clone:precision()):toBe(40)
	test.expect(samePrecisionClone:precision()):toBe(80)
	test.expect(tostring(float.fromString("ff", 16, 80))):toBe("255")
	test.expect(tostring(float.fromNumber(1.5, 80))):toBe("1.5")
	test.expect(tostring(float.fromInteger(i(7), 80))):toBe("7")
	test.expect(tostring(float.fromRational(r(1, 8), 80))):toBe("0.125")
	test.expect(float.zero(120):precision()):toBe(120)
	test.expect(float.one(96):precision()):toBe(96)
	test.expect(float.isFloat(float.one())):toBeTrue()
	test.expect(float.isFloat(1.25)):toBeFalse()

	float.setDefaultPrecision(96)
	test.expect(float.defaultPrecision()):toBe(96)
	float.setDefaultPrecision(originalPrecision)
	test.expect(float.defaultPrecision()):toBe(originalPrecision)

	test.expect(function()
		float.fromString("nope", 10, 80)
	end):toError()
	test.expect(function()
		float.fromString("10", 1, 80)
	end):toError()
end)

suite:test("float predicates clone non-finite values and sign handling cover edge cases", function()
	local nan = float.fromNumber(0 / 0, 80)
	local inf = float.fromNumber(math.huge, 80)
	local negInf = float.fromNumber(-math.huge, 80)
	local neg = f("-1.5", 80)
	local negSqrt = f("-1", 80):sqrt()

	test.expect(tostring(neg:clone())):toBe("-1.5")
	test.expect(tostring(neg:abs())):toBe("1.5")
	test.expect(neg:sign()):toBe(-1)
	test.expect(float.zero():isZero()):toBeTrue()
	test.expect(f("1", 80):isZero()):toBeFalse()
	test.expect(nan:isFinite()):toBeFalse()
	test.expect(inf:isFinite()):toBeFalse()
	test.expect(nan:isNaN()):toBeTrue()
	test.expect(inf:isNaN()):toBeFalse()
	test.expect(inf:isInfinite()):toBeTrue()
	test.expect(negInf:isInfinite()):toBeTrue()
	test.expect(f("1", 80):isInfinite()):toBeFalse()
	test.expect(tostring(nan)):toBe("nan")
	test.expect(tostring(inf)):toBe("inf")
	test.expect(tostring(negInf)):toBe("-inf")
	test.expect(tostring(negSqrt)):toBe("nan")
	test.expect(negSqrt:isFinite()):toBeFalse()

	test.expect(function()
		nan:sign()
	end):toError()
	test.expect(function()
		nan:cmp(f("1", 80))
	end):toError()
	test.expect(function()
		f("1", 80):cmp(nan)
	end):toError()
	test.expect(nan < f("1", 80)):toBeFalse()
	test.expect(f("1", 80) < nan):toBeFalse()
	test.expect(nan <= f("1", 80)):toBeFalse()
	test.expect(f("1", 80) <= nan):toBeFalse()
end)

suite:test("float arithmetic metamethods comparisons and powers cover exact and inexact cases", function()
	local a = f("1.5", 80)

	test.expect(tostring(a + 0.25)):toBe("1.75")
	test.expect(tostring(0.25 + a)):toBe("1.75")
	test.expect(tostring(a - 0.5)):toBe("1")
	test.expect(tostring(a * 2)):toBe("3")
	test.expect(tostring(a / 2)):toBe("0.75")
	test.expect(tostring(-a)):toBe("-1.5")
	test.expect(tostring(f("2", 80) ^ 3)):toBe("8")
	test.expect(a < f("2", 80)):toBeTrue()
	test.expect(a <= f("1.5", 80)):toBeTrue()
	test.expect(a:cmp(1.5)):toBe(0)
	test.expect(f("1.5", 80) == f("1.5", 80)):toBeTrue()

	test.expect(function()
		local _ = a / 0
	end):toError()
	test.expect(function()
		local _ = a % 0
	end):toError()
end)

suite:test("float rounding precision and integer projections cover ties negatives and flooring semantics", function()
	local positive = f("2.5", 80)
	local negative = f("-2.5", 80)
	local value = f("7.5", 80)
	local rounded = f("1.5", 80):withPrecision(20, "nearest_even")

	test.expect(positive:precision()):toBe(80)
	test.expect(positive:withPrecision(40):precision()):toBe(40)
	test.expect(rounded:precision()):toBe(20)
	test.expect(tostring(rounded)):toBe("1.5")
	test.expect(tostring(positive:floor())):toBe("2")
	test.expect(tostring(positive:ceil())):toBe("3")
	test.expect(tostring(negative:trunc())):toBe("-2")
	test.expect(tostring(positive:round())):toBe("3")
	test.expect(tostring(positive:round("nearest_even"))):toBe("2")
	test.expect(tostring(negative:round("nearest_away"))):toBe("-3")
	test.expect(tostring(value:toInteger())):toBe("7")
	test.expect(tostring(value:toInteger("ceil"))):toBe("8")
	test.expect(tostring(value // 2)):toBe("3")
	test.expect(tostring(value % 2)):toBe("1.5")

	test.expect(function()
		positive:withPrecision(40, "nearest_away")
	end):toError()
end)

suite:test("float string and scalar conversions cover roots bases and rational rounding inputs", function()
	local perfectSquare = f("9", 80)
	local third = float.fromRational(r(1, 3), 80, "nearest_even")
	local inf = float.fromNumber(math.huge, 80)
	local nan = float.fromNumber(0 / 0, 80)

	test.expect(tostring(perfectSquare:sqrt())):toBe("3")
	test.expect(f("10", 80):toString(16)):toBe("a")
	test.expect(f("10", 80):toString(10, 3)):toBe("10.0")
	test.expect(f("7.5", 80):toNumber()):toBe(7.5)
	test.expect(inf:toString()):toBe("inf")
	test.expect(nan:toString()):toBe("nan")
	test.expect(third:toNumber()):toBeGreaterThan(0.3333333333333)
	test.expect(third:toNumber()):toBeLessThan(0.3333333333334)

	test.expect(function()
		float.fromRational(r(1, 3), 80, "nearest_away")
	end):toError()
	test.expect(function()
		float.fromNumber(0 / 0, 80):toInteger()
	end):toError()
	test.expect(function()
		float.fromNumber(math.huge, 80):toInteger()
	end):toError()
	test.expect(function()
		f("10", 80):toString(1)
	end):toError()
end)

suite:test("dynamic number constructors projections and stored kinds are explicit", function()
	local intValue = dynamic.new(42)
	local cloned = dynamic.new(intValue)
	local floatValue = dynamic.fromString("1.25", 10, 80)
	local floatClone = dynamic.fromFloat(f("2.5", 80), 40)
	local intView = intValue:integer()
	local floatView = floatValue:float()

	test.expect(tostring(dynamic.new())):toBe("0")
	test.expect(intValue:kind()):toBe("integer")
	test.expect(intValue:isInteger()):toBeTrue()
	test.expect(intValue:isFloat()):toBeFalse()
	test.expect(tostring(intView or error("missing Integer view"))):toBe("42")
	test.expect(intValue:float()):toBeNil()
	test.expect(tostring(cloned)):toBe("42")
	test.expect(floatValue:kind()):toBe("float")
	test.expect(floatValue:isFloat()):toBeTrue()
	test.expect(floatValue:isInteger()):toBeFalse()
	test.expect(floatValue:integer()):toBeNil()
	test.expect((floatView or error("missing Float view")):precision()):toBe(80)
	test.expect(floatClone:kind()):toBe("float")
	test.expect(((floatClone:float()) or error("missing Float view")):precision()):toBe(40)
	test.expect(tostring(dynamic.fromInteger(i(7)))):toBe("7")
	test.expect(tostring(dynamic.fromNumber(3.5, 80))):toBe("3.5")
	test.expect(tostring(dynamic.zero())):toBe("0")
	test.expect(tostring(dynamic.one())):toBe("1")
	test.expect(dynamic.isNumber(dynamic.one())):toBeTrue()
	test.expect(dynamic.isNumber(integer.one())):toBeFalse()

	test.expect(function()
		dynamic.fromString("nope", 10, 80)
	end):toError()
	test.expect(function()
		dynamic.fromString("10", 1, 80)
	end):toError()
end)

suite:test("dynamic number arithmetic promotes to float only when the operation needs it", function()
	local a = dynamic.fromInteger(7)
	local b = dynamic.fromInteger(5)
	local sum = a + b
	local mixed = a + 0.5
	local quotient = a / 2
	local integerQuotient = a // 3
	local floatValue = dynamic.fromNumber(7.5, 80)
	local floatQuotient = floatValue // 2
	local mixedFloatQuotient = dynamic.fromInteger(7) // 2.0
	local floatRemainder = floatValue % 2
	local intPow = dynamic.fromInteger(3) ^ 4
	local floatPow = dynamic.fromInteger(2) ^ -1

	test.expect(sum:kind()):toBe("integer")
	test.expect(tostring(sum)):toBe("12")
	test.expect(mixed:kind()):toBe("float")
	test.expect(tostring(mixed)):toBe("7.5")
	test.expect(quotient:kind()):toBe("float")
	test.expect(tostring(quotient)):toBe("3.5")
	test.expect(integerQuotient:kind()):toBe("integer")
	test.expect(tostring(integerQuotient)):toBe("2")
	test.expect(floatQuotient:kind()):toBe("integer")
	test.expect(tostring(floatQuotient)):toBe("3")
	test.expect(mixedFloatQuotient:kind()):toBe("integer")
	test.expect(tostring(mixedFloatQuotient)):toBe("3")
	test.expect(floatRemainder:kind()):toBe("float")
	test.expect(tostring(floatRemainder)):toBe("1.5")
	test.expect(intPow:kind()):toBe("integer")
	test.expect(tostring(intPow)):toBe("81")
	test.expect(floatPow:kind()):toBe("float")
	test.expect(tostring(floatPow)):toBe("0.5")
end)

suite:test("dynamic number conversions comparisons and exceptional values stay explicit", function()
	local huge = dynamic.fromString("9007199254740993")
	local intValue = dynamic.fromInteger(-7)
	local floatValue = dynamic.fromString("2.5", 10, 80)
	local nan = dynamic.fromFloat(0 / 0, 80)
	local asFloat = dynamic.fromInteger(7):toFloat(80)

	test.expect(tostring(intValue:clone())):toBe("-7")
	test.expect(tostring(intValue:abs())):toBe("7")
	test.expect(intValue:sign()):toBe(-1)
	test.expect(floatValue:sign()):toBe(1)
	test.expect(intValue:cmp(dynamic.fromInteger(-7))):toBe(0)
	test.expect(intValue:cmp(dynamic.fromInteger(0))):toBeLessThan(0)
	test.expect(dynamic.fromInteger(3) == dynamic.fromInteger(3)):toBeTrue()
	test.expect(dynamic.fromInteger(3) < dynamic.fromInteger(4)):toBeTrue()
	test.expect(dynamic.fromInteger(4) <= dynamic.fromInteger(4)):toBeTrue()
	test.expect(tostring(floatValue:toInteger())):toBe("2")
	test.expect(typeof(asFloat)):toBe("Float")
	test.expect(asFloat:precision()):toBe(80)
	test.expect(floatValue:toNumber()):toBe(2.5)
	test.expect(tostring(dynamic.fromInteger(42):toString(16))):toBe("2a")
	test.expect(dynamic.fromNumber(7.5, 80):toString(10, 3)):toBe("7.50")
	test.expect(nan < dynamic.zero()):toBeFalse()

	test.expect(function()
		huge:toNumber()
	end):toError()
	test.expect(function()
		nan:cmp(dynamic.zero())
	end):toError()
	test.expect(function()
		nan:sign()
	end):toError()
end)

suite:test("dynamic number whole-value helpers promote back to integer-kind values", function()
	local positive = dynamic.fromString("2.5", 10, 80)
	local negative = dynamic.fromString("-2.5", 10, 80)
	local integerValue = dynamic.fromInteger(9)
	local floored = positive:floor()
	local ceiled = positive:ceil()
	local truncated = negative:trunc()
	local rounded = positive:round()
	local evenRounded = positive:round("nearest_even")
	local awayRounded = negative:round("nearest_away")

	test.expect(floored:kind()):toBe("integer")
	test.expect(tostring(floored)):toBe("2")
	test.expect(ceiled:kind()):toBe("integer")
	test.expect(tostring(ceiled)):toBe("3")
	test.expect(truncated:kind()):toBe("integer")
	test.expect(tostring(truncated)):toBe("-2")
	test.expect(rounded:kind()):toBe("integer")
	test.expect(tostring(rounded)):toBe("3")
	test.expect(evenRounded:kind()):toBe("integer")
	test.expect(tostring(evenRounded)):toBe("2")
	test.expect(awayRounded:kind()):toBe("integer")
	test.expect(tostring(awayRounded)):toBe("-3")
	test.expect(integerValue:floor():kind()):toBe("integer")
	test.expect(tostring(integerValue:floor())):toBe("9")

	test.expect(function()
		positive:round("oops")
	end):toError()
	test.expect(function()
		dynamic.fromFloat(0 / 0, 80):floor()
	end):toError()
end)

suite:test("ergonomic workflows document the intended happy path", function()
	local originalPrecision = float.defaultPrecision()
	local big = integer.fromString("123456789012345678901234567890")
	local exactRatio = rational.new(big, 10)
	local promoted = exactRatio:toFloat(128)

	float.setDefaultPrecision(96)

	local dynamicThird = dynamic.fromInteger(1) / 3
	local lowered = dynamicThird:floor()
	local reRaised = lowered:toFloat()
	local dynamicThirdFloat = dynamicThird:float() or error("missing Float view")

	float.setDefaultPrecision(originalPrecision)

	test.expect(tostring(big + 10)):toBe("123456789012345678901234567900")
	test.expect(tostring(promoted)):toBe("12345678901234567890123456789")
	test.expect(dynamicThird:kind()):toBe("float")
	test.expect(dynamicThirdFloat:precision()):toBe(96)
	test.expect(lowered:kind()):toBe("integer")
	test.expect(tostring(lowered)):toBe("0")
	test.expect(typeof(reRaised)):toBe("Float")
	test.expect(reRaised:precision()):toBe(96)
end)

return suite
