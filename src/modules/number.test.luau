suite:test("integer bit helpers formatting and shifts cover boundary behavior", function()
	local value = i(42)

	test.expect(integer.zero():bitLength()):toBe(0)
	test.expect(value:bitLength()):toBe(6)
	test.expect(value:popcount()):toBe(3)
	test.expect(value:testBit(1)):toBeTrue()
	test.expect(value:testBit(0)):toBeFalse()
	test.expect(tostring(value:setBit(0))):toBe("43")
	test.expect(tostring(value:clearBit(1))):toBe("40")
	test.expect(tostring(value:flipBit(2))):toBe("46")
	test.expect(tostring(value:band(15))):toBe("10")
	test.expect(tostring(value:bor(1))):toBe("43")
	test.expect(tostring(value:bxor(7))):toBe("45")
	test.expect(tostring(value:bnot())):toBe("-43")
	test.expect(tostring(value:shl(3))):toBe("336")
	test.expect(tostring(value:shr(1))):toBe("21")
	test.expect(tostring(value:shl(-1))):toBe("21")
	test.expect(tostring(value:shr(-1))):toBe("84")
	test.expect(value:toString(16)):toBe("2a")

	test.expect(function()
		i(-1):popcount()
	end):toError()
end)

suite:test("integer scalar conversions cover exactness and fixed-width boundaries", function()
	local exact = integer.fromString("9007199254740992")
	local inexact = integer.fromString("9007199254740993")
	local minI64 = integer.fromString("-9223372036854775808")
	local maxI64 = integer.fromString("9223372036854775807")
	local belowI64 = integer.fromString("-9223372036854775809")
	local aboveI64 = integer.fromString("9223372036854775808")
	local maxU64 = integer.fromString("18446744073709551615")
	local aboveU64 = integer.fromString("18446744073709551616")

	test.expect(exact:fitsNumber()):toBeTrue()
	test.expect(exact:toNumber()):toBe(9007199254740992)
	test.expect(inexact:fitsNumber()):toBeFalse()
	test.expect(function()
		inexact:toNumber()
	end):toError()

	test.expect(minI64:fitsI64()):toBeTrue()
	test.expect(maxI64:fitsI64()):toBeTrue()
	test.expect(belowI64:fitsI64()):toBeFalse()
	test.expect(aboveI64:fitsI64()):toBeFalse()
	test.expect(maxU64:fitsU64()):toBeTrue()
	test.expect(aboveU64:fitsU64()):toBeFalse()
	test.expect(integer.fromI64(-123):toI64()):toBe(-123i)
	test.expect(integer.fromU64(123):toU64()):toBe(123i)
	test.expect(integer.fromU64(123):fitsU64()):toBeTrue()
	test.expect(i(-1):fitsU64()):toBeFalse()
	test.expect(tostring(i(9):toRational())):toBe("9")
	test.expect(tostring(i(9):toFloat(80))):toBe("9")

	test.expect(function()
		i(-1):toU64()
	end):toError()
	test.expect(function()
		aboveI64:toI64()
	end):toError()
	test.expect(function()
		aboveU64:toU64()
	end):toError()
	test.expect(function()
		integer.fromU64(-1i)
	end):toError()
end)

