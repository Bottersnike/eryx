suite:test("rational constructors parse decimal textual and promoted inputs", function()
	test.expect(tostring(rational.new())):toBe("0")
	test.expect(tostring(r(6, 8))):toBe("3/4")
	test.expect(tostring(rational.new(i(5)))):toBe("5")
	test.expect(tostring(rational.new(r(3, 4)))):toBe("3/4")
	test.expect(tostring(rational.new(i(3), 2))):toBe("3/2")
	test.expect(tostring(rational.new(r(3, 4), r(5, 6)))):toBe("9/10")
	test.expect(tostring(rational.fromString("10/20"))):toBe("1/2")
	test.expect(tostring(rational.fromString("1e3"))):toBe("1000")
	test.expect(tostring(rational.fromDecimal("1.25"))):toBe("5/4")
	test.expect(tostring(rational.fromDecimal("-1.25e1"))):toBe("-25/2")
	test.expect(tostring(rational.fromFloat(0.5))):toBe("1/2")
	test.expect(tostring(rational.fromInteger(7))):toBe("7")
	test.expect(tostring(rational.zero())):toBe("0")
	test.expect(tostring(rational.one())):toBe("1")
	test.expect(rational.isRational(rational.one())):toBeTrue()
	test.expect(rational.isRational(integer.one())):toBeFalse()

	test.expect(function()
		rational.new(1, 0)
	end):toError()
	test.expect(function()
		rational.fromString("1.5", 16)
	end):toError()
	test.expect(function()
		rational.fromDecimal("nope")
	end):toError()
end)

suite:test("rational clone predicates accessors and comparisons are exact", function()
	local value = rational.fromString("6/8")
	local clone = value:clone()

	test.expect(tostring(clone)):toBe("3/4")
	test.expect(tostring(value:abs())):toBe("3/4")
	test.expect(tostring(r(-3, 4):abs())):toBe("3/4")
	test.expect(value:sign()):toBe(1)
	test.expect(r(0):sign()):toBe(0)
	test.expect(r(-1, 2):sign()):toBe(-1)
	test.expect(value:cmp(r(2, 3))):toBeGreaterThan(0)
	test.expect(value:isZero()):toBeFalse()
	test.expect(value:isOne()):toBeFalse()
	test.expect(value:isInteger()):toBeFalse()
	test.expect(tostring(value:numerator())):toBe("3")
	test.expect(tostring(value:denominator())):toBe("4")
	test.expect(value == rational.fromString("3/4")):toBeTrue()
	test.expect(value < rational.one()):toBeTrue()
	test.expect(value <= rational.fromString("3/4")):toBeTrue()
end)

suite:test("rational arithmetic metamethods preserve exactness", function()
	local a = r(3, 4)

	test.expect(tostring(a + r(1, 4))):toBe("1")
	test.expect(tostring(a - 0.5)):toBe("1/4")
	test.expect(tostring(0.5 + a)):toBe("5/4")
	test.expect(tostring(a * 2)):toBe("3/2")
	test.expect(tostring(a / 2)):toBe("3/8")
	test.expect(tostring(-a)):toBe("-3/4")
	test.expect(tostring(r(2, 3) ^ 3)):toBe("8/27")
	test.expect(tostring(r(2, 3) ^ -2)):toBe("9/4")

	test.expect(function()
		local _ = a / 0
	end):toError()
	test.expect(function()
		local _ = r(0) ^ -1
	end):toError()
end)

suite:test("rational division inverse rounding and integer projection cover ties and negatives", function()
	local value = r(7, 3)
	local negative = r(-7, 3)
	local half = r(5, 2)

	test.expect(tostring(value:inverse())):toBe("3/7")
	test.expect(tostring(value:canonical())):toBe("7/3")
	test.expect(tostring(value // r(1, 2))):toBe("4")
	test.expect(tostring(value % r(1, 2))):toBe("1/3")
	test.expect(tostring(value:floor())):toBe("2")
	test.expect(tostring(value:ceil())):toBe("3")
	test.expect(tostring(negative:trunc())):toBe("-2")
	test.expect(tostring(half:round())):toBe("3")
	test.expect(tostring(half:round("nearest_even"))):toBe("2")
	test.expect(tostring(r(-5, 2):round("nearest_away"))):toBe("-3")
	test.expect(tostring(negative:toInteger())):toBe("-2")
	test.expect(tostring(value:toInteger("ceil"))):toBe("3")

	test.expect(function()
		r(0):inverse()
	end):toError()
end)

suite:test("rational textual and scalar conversions cover bases decimals and repeating forms", function()
	test.expect(r(15, 16):toString(16)):toBe("f/10")
	test.expect(r(1, 2):toDecimal(0)):toBe("1")
