local number = require("@eryx/number")
local test = require("@eryx/test")

local suite = test.Suite.new("number")
local integer = number.integer
local rational = number.rational
local float = number.float
local dynamic = number.number

local function i(value: number | string)
	return integer.new(value)
end

local function r(a: number | string, b: number?)
	if b == nil then
		return rational.new(a :: any)
	end
	return rational.new(a :: any, b)
end

local function f(value: any, precision: number?)
	if precision == nil then
		return float.new(value)
	end
	return float.new(value, precision)
end

suite:test("typeof names are exposed for number userdata", function()
	test.expect(typeof(integer.one())):toBe("Integer")
	test.expect(typeof(rational.one())):toBe("Rational")
	test.expect(typeof(float.one())):toBe("Float")
	test.expect(typeof(dynamic.one())):toBe("Number")
end)

suite:test("integer constructors clone parse and identify values", function()
	local value = integer.new(42)

	test.expect(tostring(integer.new())):toBe("0")
	test.expect(tostring(integer.new(value))):toBe("42")
	test.expect(tostring(integer.fromString("ff", 16))):toBe("255")
	test.expect(tostring(integer.fromNumber(-12))):toBe("-12")
	test.expect(tostring(integer.zero())):toBe("0")
	test.expect(tostring(integer.one())):toBe("1")
	test.expect(integer.isInteger(value)):toBeTrue()
	test.expect(integer.isInteger(42)):toBeFalse()
	test.expect(integer.isInteger("42")):toBeFalse()

	test.expect(function()
		integer.fromString("nope", 10)
	end):toError()
	test.expect(function()
		integer.fromString("10", 1)
	end):toError()
	test.expect(function()
		integer.fromNumber(1.5)
	end):toError()
end)

suite:test("integer predicates clone comparison and signs cover basic cases", function()
	local neg = i(-7)
	local zero = integer.zero()
	local one = integer.one()
	local even = i(8)
	local odd = i(9)
	local clone = neg:clone()

	test.expect(tostring(clone)):toBe("-7")
	test.expect(tostring(neg:abs())):toBe("7")
	test.expect(neg:sign()):toBe(-1)
	test.expect(zero:sign()):toBe(0)
	test.expect(one:sign()):toBe(1)
	test.expect(i(12):cmp(12)):toBe(0)
	test.expect(i(12):cmp(13)):toBeLessThan(0)
	test.expect(i(12):cmp(11)):toBeGreaterThan(0)
	test.expect(zero:isZero()):toBeTrue()
	test.expect(one:isOne()):toBeTrue()
	test.expect(even:isEven()):toBeTrue()
	test.expect(even:isOdd()):toBeFalse()
	test.expect(odd:isOdd()):toBeTrue()
	test.expect(odd:isEven()):toBeFalse()
	test.expect(i(5) == i(5)):toBeTrue()
	test.expect(i(4) < i(5)):toBeTrue()
	test.expect(i(5) <= i(5)):toBeTrue()
end)

suite:test("integer arithmetic metamethods stay exact with integers and numbers", function()
	local a = i(7)

	test.expect(tostring(a + i(5))):toBe("12")
	test.expect(tostring(a + 5)):toBe("12")
	test.expect(tostring(5 + a)):toBe("12")
	test.expect(tostring(a - 2)):toBe("5")
	test.expect(tostring(2 - a)):toBe("-5")
	test.expect(tostring(a * 6)):toBe("42")
	test.expect(tostring(-a)):toBe("-7")
	test.expect(tostring(a // 3)):toBe("2")
	test.expect(tostring(a % 3)):toBe("1")
	test.expect(tostring(a ^ 4)):toBe("2401")

	test.expect(function()
		local _ = a // 0
	end):toError()
	test.expect(function()
		local _ = a % 0
	end):toError()
end)

suite:test("integer division helpers cover trunc floor ceil and remainders", function()
	local neg = i(-7)
	local pos = i(7)

	test.expect(tostring(neg:divTrunc(3))):toBe("-2")
	test.expect(tostring(neg:divFloor(3))):toBe("-3")
	test.expect(tostring(neg:divCeil(3))):toBe("-2")

	local q1, r1 = neg:divmod(3)
	test.expect(tostring(q1)):toBe("-3")
	test.expect(tostring(r1)):toBe("2")

	local q2, r2 = pos:divmod(3, "trunc")
	test.expect(tostring(q2)):toBe("2")
	test.expect(tostring(r2)):toBe("1")

	test.expect(function()
		pos:divmod(0)
	end):toError()
	test.expect(function()
		pos:divmod(3, "nearest_even")
	end):toError()
end)

suite:test("integer number theory helpers cover gcd lcm extended gcd powers and inverses", function()
	local a = i(240)
	local b = i(46)
	local g, x, y = a:extendedGcd(b)

	test.expect(tostring(a:gcd(b))):toBe("2")
	test.expect(tostring(a:lcm(b))):toBe("5520")
	test.expect(tostring(g)):toBe("2")
	test.expect(tostring(a * x + b * y)):toBe("2")
	test.expect(tostring(i(7):pow(5))):toBe("16807")
	test.expect(tostring(i(7):modPow(128, 13))):toBe("3")
	test.expect(tostring(i(3):modInverse(11) or error("missing inverse"))):toBe("4")
	test.expect(i(6):modInverse(9)):toBeNil()

	test.expect(function()
		i(2):pow(-1)
	end):toError()
	test.expect(function()
		i(2):modPow(-1, 5)
	end):toError()
	test.expect(function()
		i(2):modPow(5, 0)
	end):toError()
end)

suite:test("integer primality combinatorics and module helpers cover edge cases", function()
	test.expect(i(97):isProbablePrime()):toBeTrue()
	test.expect(i(1):isProbablePrime(0)):toBeFalse()
	test.expect(tostring(i(100):nextPrime())):toBe("101")
	test.expect(tostring(integer.factorial(0))):toBe("1")
	test.expect(tostring(integer.factorial(10))):toBe("3628800")
	test.expect(tostring(integer.binomial(10, 0))):toBe("1")
	test.expect(tostring(integer.binomial(10, 3))):toBe("120")

	test.expect(function()
		integer.factorial(-1)
	end):toError()
