local fs = require("@eryx/fs")
local osmod = require("@eryx/os")
local pathmod = require("@eryx/path")
local tempfile = require("@eryx/tempfile")
local test = require("@eryx/test")

local suite = test.Suite.new("path")

suite:test("unix relative path operations match the design matrix", function()
	local p = pathmod.newUnix("foo/bar.txt")

	test.expect(p:platform()):toBe("unix")
	test.expect(p:hasPrefix()):toBeFalse()
	test.expect(p:hasRoot()):toBeFalse()
	test.expect(tostring(p:join("baz"))):toBe("foo/bar.txt/baz")
	test.expect(tostring(p:parent() or error("missing parent"))):toBe("foo")
	test.expect(p:name()):toBe("bar.txt")
	test.expect(p:stem()):toBe("bar")
	test.expect(p:extension()):toBe("txt")
	test.expect(tostring(p:normalizeDots())):toBe("foo/bar.txt")
	test.expect(p:isAbsolute()):toBeFalse()
end)

suite:test("absolute unix path operations match the design matrix", function()
	local p = pathmod.newUnix("/usr/local/bin")

	test.expect(p:hasRoot()):toBeTrue()
	test.expect(p:isAbsolute()):toBeTrue()
	test.expect(tostring(p:join("python3"))):toBe("/usr/local/bin/python3")
	test.expect(tostring(p:join("/etc"))):toBe("/etc")
	test.expect(tostring(p:parent() or error("missing parent"))):toBe("/usr/local")
	test.expect(p:name()):toBe("bin")
end)

suite:test("unix dot normalization and parent behavior match the design matrix", function()
	local p = pathmod.newUnix("a/./b/../c")
	local normalized = p:normalizeDots()

	test.expect(tostring(normalized)):toBe("a/c")
	test.expect(tostring(p:parent() or error("missing parent"))):toBe("a/./b/..")
	test.expect(tostring(normalized:parent() or error("missing parent"))):toBe("a")

	local rooted = pathmod.newUnix("/../../etc/passwd")
	test.expect(tostring(rooted:normalizeDots())):toBe("/etc/passwd")
end)

suite:test("ordinary drive paths distinguish absolute, drive-relative, and rooted-relative forms", function()
	local absolute = pathmod.newNt("C:\\Windows\\System32")
	local driveRelative = pathmod.newNt("C:temp\\file.txt")
	local rootedRelative = pathmod.newNt("\\Program Files\\App")
	local relative = pathmod.newNt("foo\\bar")

	test.expect(absolute:isAbsolute()):toBeTrue()
	test.expect(absolute:hasPrefix()):toBeTrue()
	test.expect(absolute:hasRoot()):toBeTrue()
	test.expect(tostring(absolute:parent() or error("missing parent"))):toBe("C:\\Windows")
	test.expect(tostring(absolute:join("drivers"))):toBe("C:\\Windows\\System32\\drivers")
	test.expect(tostring(absolute:join("\\Temp"))):toBe("C:\\Temp")
	test.expect(tostring(absolute:join("D:\\x"))):toBe("D:\\x")
	test.expect(absolute:name()):toBe("System32")

	test.expect(driveRelative:isAbsolute()):toBeFalse()
	test.expect(driveRelative:hasPrefix()):toBeTrue()
	test.expect(driveRelative:hasRoot()):toBeFalse()
	test.expect(tostring(driveRelative:join("more"))):toBe("C:temp\\file.txt\\more")
	test.expect(tostring(driveRelative:parent() or error("missing parent"))):toBe("C:temp")

	test.expect(rootedRelative:isAbsolute()):toBeFalse()
	test.expect(rootedRelative:hasPrefix()):toBeFalse()
	test.expect(rootedRelative:hasRoot()):toBeTrue()
	test.expect(tostring(rootedRelative:join("bin"))):toBe("\\Program Files\\App\\bin")
	test.expect(tostring(absolute:join(rootedRelative))):toBe("C:\\Program Files\\App")

	test.expect(relative:isAbsolute()):toBeFalse()
	test.expect(tostring(relative:join("baz"))):toBe("foo\\bar\\baz")
	test.expect(tostring(relative:join("C:\\x"))):toBe("C:\\x")
	test.expect(tostring(relative:join("\\x"))):toBe("\\x")
	test.expect(tostring(relative:normalizeDots())):toBe("foo\\bar")
end)

suite:test("ordinary nt parsing treats forward slash as a separator", function()
	local p = pathmod.newNt("C:/Users/Emma\\file.txt")

	test.expect(tostring(p)):toBe("C:\\Users\\Emma\\file.txt")
	test.expect(tostring(p:normalizeSeparators())):toBe("C:\\Users\\Emma\\file.txt")
end)

suite:test("unc paths behave like rooted volume paths", function()
	local shareRoot = pathmod.newNt("\\\\server\\share")
	local insideShare = pathmod.newNt("\\\\server\\share\\dir\\file.txt")

	test.expect(shareRoot:isAbsolute()):toBeTrue()
	test.expect(shareRoot:isUnc()):toBeTrue()
	test.expect(shareRoot:parent()):toBeNil()
	test.expect(shareRoot:name()):toBeNil()
	test.expect(tostring(shareRoot:join("dir"))):toBe("\\\\server\\share\\dir")

	test.expect(tostring(insideShare:parent() or error("missing parent"))):toBe("\\\\server\\share\\dir")
	test.expect(insideShare:name()):toBe("file.txt")
	test.expect(insideShare:stem()):toBe("file")
	test.expect(insideShare:extension()):toBe("txt")
	test.expect(tostring(insideShare:join("more"))):toBe("\\\\server\\share\\dir\\file.txt\\more")
	test.expect(tostring(insideShare:join("\\x"))):toBe("\\\\server\\share\\x")
end)

suite:test("verbatim disk, verbatim unc, and generic verbatim paths keep their distinct prefix families", function()
	local verbatimDisk = pathmod.newNt("\\\\?\\C:\\very\\long\\path")
	local withDots = pathmod.newNt("\\\\?\\C:\\a\\.\\b\\..\\c")
	local verbatimUnc = pathmod.newNt("\\\\?\\UNC\\server\\share\\dir\\file.txt")
	local genericVerbatim = pathmod.newNt("\\\\?\\pipe\\mypipe")

	test.expect(verbatimDisk:isAbsolute()):toBeTrue()
	test.expect(verbatimDisk:isVerbatim()):toBeTrue()
	test.expect(tostring(verbatimDisk:join("x"))):toBe("\\\\?\\C:\\very\\long\\path\\x")
	test.expect(verbatimDisk:toDisplayString()):toBe("C:\\very\\long\\path")

	test.expect(tostring(withDots:normalizeDots())):toBe("\\\\?\\C:\\a\\.\\b\\..\\c")
	test.expect(tostring(withDots:normalizeDotsUnsafe())):toBe("\\\\?\\C:\\a\\c")

	test.expect(verbatimUnc:isAbsolute()):toBeTrue()
	test.expect(verbatimUnc:isUnc()):toBeTrue()
	test.expect(verbatimUnc:isVerbatim()):toBeTrue()
	test.expect(tostring(verbatimUnc:parent() or error("missing parent"))):toBe("\\\\?\\UNC\\server\\share\\dir")
	test.expect(tostring(verbatimUnc:join("x"))):toBe("\\\\?\\UNC\\server\\share\\dir\\file.txt\\x")

	test.expect(genericVerbatim:isVerbatim()):toBeTrue()
	test.expect(tostring(genericVerbatim:join("x"))):toBe("\\\\?\\pipe\\mypipe\\x")
end)

suite:test("device namespace paths stay distinct and conservative", function()
	local com = pathmod.newNt("\\\\.\\COM56")
	local physical = pathmod.newNt("\\\\.\\PhysicalDrive0")
	local driveDevice = pathmod.newNt("\\\\.\\C:")
	local deviceUnc = pathmod.newNt("\\\\.\\UNC\\server\\share\\dir")

	test.expect(com:isDevice()):toBeTrue()
	test.expect(com:isAbsolute()):toBeTrue()
	test.expect(com:parent()):toBeNil()
	test.expect(function()
		com:join("x")
	end):toError("device%-only")

	test.expect(physical:isDevice()):toBeTrue()
	test.expect(physical:parent()):toBeNil()
	test.expect(function()
		physical:join("x")
	end):toError("device%-only")

	test.expect(driveDevice:isDevice()):toBeTrue()
	test.expect(tostring(driveDevice:join("\\foo"))):toBe("\\\\.\\C:\\foo")

	test.expect(deviceUnc:isDevice()):toBeTrue()
	test.expect(tostring(deviceUnc:join("x"))):toBe("\\\\.\\UNC\\server\\share\\dir\\x")
end)

suite:test("reserved dos names are queries on the final component, not parse failures", function()
	local con = pathmod.newNt("CON")
	local nul = pathmod.newNt("NUL.txt")
	local lpt = pathmod.newNt("C:\\temp\\LPT1.log")

	test.expect(con:isReservedName()):toBeTrue()
	test.expect(con:name()):toBe("CON")
	test.expect(tostring(con:join("x"))):toBe("CON\\x")

	test.expect(nul:isReservedName()):toBeTrue()
	test.expect(nul:stem()):toBe("NUL")
	test.expect(nul:extension()):toBe("txt")

	test.expect(lpt:isReservedName()):toBeTrue()
	test.expect(tostring(lpt:parent() or error("missing parent"))):toBe("C:\\temp")
end)

suite:test("ordinary nt dot normalization respects rooted and relative semantics", function()
	local ordinary = pathmod.newNt("C:\\a\\.\\b\\..\\c")
	local leadingParents = pathmod.newNt("..\\a\\..\\b")
	local rootedParents = pathmod.newNt("C:\\..\\..\\Windows")

	test.expect(tostring(ordinary:normalizeDots())):toBe("C:\\a\\c")
	test.expect(tostring(leadingParents:normalizeDots())):toBe("..\\b")
	test.expect(tostring(rootedParents:normalizeDots())):toBe("C:\\Windows")
end)

suite:test("join replacement tiers match the design matrix", function()
	local diskBase = pathmod.newNt("C:\\Users\\Emma")
	local uncBase = pathmod.newNt("\\\\server\\share\\dir")
	local unixBase = pathmod.newUnix("/usr/local")

	test.expect(tostring(diskBase:join("docs"))):toBe("C:\\Users\\Emma\\docs")
	test.expect(tostring(diskBase:join("..\\tmp"))):toBe("C:\\Users\\Emma\\..\\tmp")
	test.expect(tostring(diskBase:join("\\Windows"))):toBe("C:\\Windows")
	test.expect(tostring(diskBase:join("D:\\x"))):toBe("D:\\x")
	test.expect(tostring(diskBase:join("D:y"))):toBe("D:y")
	test.expect(tostring(diskBase:join("\\\\server\\share\\a"))):toBe("\\\\server\\share\\a")
	test.expect(tostring(diskBase:join("\\\\?\\C:\\x"))):toBe("\\\\?\\C:\\x")
	test.expect(tostring(diskBase:join("\\\\.\\COM56"))):toBe("\\\\.\\COM56")

	test.expect(tostring(uncBase:join("x"))):toBe("\\\\server\\share\\dir\\x")
	test.expect(tostring(uncBase:join("\\x"))):toBe("\\\\server\\share\\x")
	test.expect(tostring(uncBase:join("\\\\other\\s\\y"))):toBe("\\\\other\\s\\y")
	test.expect(tostring(uncBase:join("C:\\x"))):toBe("C:\\x")

	test.expect(tostring(unixBase:join("bin"))):toBe("/usr/local/bin")
	test.expect(tostring(unixBase:join("/etc"))):toBe("/etc")
	test.expect(tostring(unixBase:join("../tmp"))):toBe("/usr/local/../tmp")
end)

suite:test("separator normalization is conservative for verbatim paths", function()
	local ordinary = pathmod.newNt("C:/a/b\\c")
	local verbatim = pathmod.newNt("\\\\?\\C:/a/b")

	test.expect(tostring(ordinary:normalizeSeparators())):toBe("C:\\a\\b\\c")
	test.expect(tostring(verbatim)):toBe("\\\\?\\C:/a/b")
	test.expect(tostring(verbatim:normalizeSeparators())):toBe("\\\\?\\C:/a/b")
end)

suite:test("parent edge cases match the design matrix", function()
	local driveRoot = pathmod.newNt("C:\\")
	local shareRoot = pathmod.newNt("\\\\server\\share\\")
	local unixRoot = pathmod.newUnix("/")
	local trailing = pathmod.newNt("C:\\temp\\")

	test.expect(driveRoot:parent()):toBeNil()
	test.expect(driveRoot:name()):toBeNil()

	test.expect(shareRoot:parent()):toBeNil()
	test.expect(shareRoot:name()):toBeNil()

	test.expect(unixRoot:parent()):toBeNil()
	test.expect(unixRoot:name()):toBeNil()

	test.expect(trailing:hasTrailingSeparator()):toBeTrue()
	test.expect(trailing:name()):toBe("temp")
	test.expect(tostring(trailing:parent() or error("missing parent"))):toBe("C:\\")
end)

suite:test("relativeTo stays lexical and refuses mismatched volumes", function()
	local unixBase = pathmod.newUnix("/a/b")
	local unixPath = pathmod.newUnix("/a/b/c/d")
	local winBase = pathmod.newNt("C:\\a\\b")
	local winPath = pathmod.newNt("C:\\a\\b\\c\\d")
	local otherDrive = pathmod.newNt("D:\\a\\b")
	local uncBase = pathmod.newNt("\\\\s1\\share\\a")
	local otherUnc = pathmod.newNt("\\\\s2\\share\\a")
	local driveRelative = pathmod.newNt("C:c\\d")

	test.expect(tostring(unixPath:relativeTo(unixBase) or error("missing relative path"))):toBe("c/d")
	test.expect(tostring(winPath:relativeTo(winBase) or error("missing relative path"))):toBe("c\\d")
	test.expect(otherDrive:relativeTo(winBase)):toBeNil()
	test.expect(otherUnc:relativeTo(uncBase)):toBeNil()
	test.expect(driveRelative:relativeTo(winBase)):toBeNil()
end)

suite:test("empty and repeated-separator paths are still representable", function()
	local emptyUnix = pathmod.newUnix("")
	local repeated = pathmod.newUnix("foo///bar")

	test.expect(emptyUnix:hasPrefix()):toBeFalse()
	test.expect(emptyUnix:hasRoot()):toBeFalse()
	test.expect(#emptyUnix:components()):toBe(0)
	test.expect(tostring(emptyUnix:join("x"))):toBe("x")

	test.expect(repeated:raw()):toBe("foo///bar")
	test.expect(#repeated:components()):toBe(2)
	test.expect(tostring(repeated:normalizeSeparators())):toBe("foo/bar")
end)

suite:test("top-level convenience helpers accept PathLike and mirror common fs.path ergonomics", function()
	local unixBase = pathmod.newUnix("/usr")
	local joinedUnix = pathmod.join(unixBase, "local", "bin", "lua")

	test.expect(pathmod.isPath(joinedUnix)):toBeTrue()
	test.expect(tostring(joinedUnix)):toBe("/usr/local/bin/lua")
	test.expect(tostring(pathmod.dirname(joinedUnix) or error("missing dirname"))):toBe("/usr/local/bin")
	test.expect(pathmod.basename(joinedUnix)):toBe("lua")
	test.expect(pathmod.stem(pathmod.newUnix("archive.tar.gz"))):toBe("archive.tar")
	test.expect(pathmod.extension(pathmod.newUnix("archive.tar.gz"))):toBe("gz")

	tempfile.withTempDir(function(dir)
		local canonical = pathmod.canonicalize(pathmod.join(dir, "."))
		test.expect(pathmod.isPath(canonical)):toBeTrue()
		test.expect(fs.exists(canonical)):toBeTrue()
		test.expect(fs.isDirectory(canonical)):toBeTrue()
	end, "path-top-level-canonicalize")
end)

suite:test("native filesystem APIs accept PathLike and os.cwd returns a string", function()
	local cwd = osmod.cwd()
	test.expect(type(cwd)):toBe("string")
	test.expect(cwd):toNotBe("")

	tempfile.withTempDir(function(dir)
		local dirPath = pathmod.new(dir)
		local filePath = dirPath:join("sample.txt")

		test.expect(fs.mkdir(dirPath:join("nested"))):toBeTrue()
		test.expect(fs.exists(dirPath:join("nested"))):toBeTrue()

		local file = fs.openSync(filePath, "w+")
		file:writeSync("hello path")
		file:seek(0, "set")
		test.expect(file:readSync()):toBe("hello path")
		file:closeSync()

		test.expect(fs.exists(filePath)):toBeTrue()
		test.expect(fs.path.dirname(filePath)):toBe(tostring(dirPath))

		local before = osmod.cwd()
		osmod.chdir(dirPath)
		test.expect(type(osmod.cwd())):toBe("string")
		test.expect(tostring(pathmod.canonicalize(osmod.cwd()))):toBe(tostring(pathmod.canonicalize(dirPath)))
		osmod.chdir(before)
	end, "pathlike-native-interop")
end)

return suite
